# Copy this file to .env and fill in the values. NEVER commit .env.
# Everything here is OPTIONAL — the app must work with all of these empty.

# Google AI Studio key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GROQ_API_KEY=

# Set automatically by docker-compose, only edit if using an external Postgres
DATABASE_URL=

# Where the browser reaches the backend (frontend reads this at dev start).
NEXT_PUBLIC_API_URL=http://localhost:8000

